<!doctype html>
<html><head><meta charset="utf-8">
<style>
{# The picture that opens each job in Telegram, so jobs stand apart when scrolling the chat. Telegram shows it
   about 300 px wide on a phone (a third of this canvas), so every text here is big; the details are in the card. #}
{{ fonts }}
* { margin: 0; padding: 0; box-sizing: border-box; }
body { width: 900px; height: 300px; font-family: "Inter", "Segoe UI", Arial, sans-serif;
       font-variant-ligatures: none; }
.banner { position: relative; overflow: hidden; width: 900px; height: 300px; display: flex; align-items: center;
          gap: 34px; padding: 0 42px; color: #fff;
          background: linear-gradient(118deg, {{ theme.accent }} 0%, {{ theme.accent_ink }} 100%); }
.banner::before { content: ""; position: absolute; border-radius: 50%; background: rgba(255,255,255,.08);
                  width: 380px; height: 380px; right: -130px; top: -170px; }
.logo { flex: none; width: 156px; height: 156px; border-radius: 34px; background: #fff; display: flex;
        align-items: center; justify-content: center; box-shadow: 0 10px 28px rgba(0,0,0,.25); }
.logo img { width: 120px; height: 120px; object-fit: contain; }
.logo span { font-size: 64px; font-weight: 800; color: {{ theme.accent_ink }}; letter-spacing: -2px; }
.text { flex: 1; min-width: 0; position: relative; }
.tag { display: inline-block; font-size: 26px; font-weight: 800; letter-spacing: 2px; padding: 6px 16px;
       border-radius: 999px; background: rgba(255,255,255,.22); }
.company { font-size: {{ company_px }}px; font-weight: 800; line-height: 1.1; margin-top: 12px; letter-spacing: -1px;
           white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.title { font-size: 36px; font-weight: 600; line-height: 1.22; margin-top: 6px; opacity: .95;
         display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.score { flex: none; position: relative; width: 148px; height: 148px; border-radius: 50%; display: flex;
         flex-direction: column; align-items: center; justify-content: center;
         border: 7px solid rgba(255,255,255,.92); background: rgba(255,255,255,.1); }
/* Jobs in the candidate's priority sector (config: priority): one fixed look, whatever the company's colors. */
.banner.priority { background: linear-gradient(118deg, #14061f 0%, #4a0f5c 52%, #b0125f 100%); }
.banner.priority::before { background: rgba(245,197,66,.13); }
.banner.priority .tag { background: #f5c542; color: #2a0c33; }
.banner.priority .tag svg { width: 24px; height: 24px; vertical-align: -3px; margin-right: 6px; }
.banner.priority .score { border-color: #f5c542; }
.score b { font-size: 66px; font-weight: 800; line-height: 1; }
.score span { font-size: 22px; font-weight: 800; letter-spacing: 2px; margin-top: 2px; opacity: .9; }
</style></head>
<body><div class="banner{{ ' priority' if priority else '' }}">
  <div class="logo">{% if logo %}<img src="{{ logo }}" alt="">{% else %}<span>{{ initials }}</span>{% endif %}</div>
  <div class="text">
    <div class="tag">{% if priority and icon == 'music' %}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9 3v10.6A3.8 3.8 0 1 0 11 17V8h7V3z"/></svg>{% elif priority %}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.9 6 6.6.8-4.9 4.6 1.3 6.5L12 17.2l-5.9 3.2 1.3-6.5L2.5 9.3l6.6-.8z"/></svg>{% endif %}{{ tag }}</div>
    <div class="company">{{ company }}</div>
    <div class="title">{{ title }}</div>
  </div>
  <div class="score"><b>{{ score }}</b><span>FIT</span></div>
</div></body></html>
