# Copy to .env and fill in. Never share or commit .env.
# AI runs through the Claude Code CLI on your own Claude account: no API key needed.
# Check it with: python -m hunter doctor

# Telegram (recommended): delivery to the phone + Applied buttons + "send me a job link"
# 1. In Telegram, open @BotFather, send /newbot, follow the steps, paste the token below
# 2. Run: python -m hunter telegram --who alex   (then press Start in the bot chat)
TELEGRAM_BOT_TOKEN=
# Filled by the command above, one per candidate:
# TELEGRAM_CHAT_ID_ALEX=
# A candidate can also have their own bot: TELEGRAM_BOT_TOKEN_ALEX=
# Errors and pauses go to this chat instead of the candidate's (set by the command above when you hand over):
# TELEGRAM_ADMIN_CHAT_ID=

# Optional: a mailbox that receives job alert emails (APEC, Cadremploi, HelloWork, Meteojob, Indeed, LinkedIn...)
# Gmail: use an App Password, never the account password. See ALERTS_SETUP.md.
ALERTS_IMAP_USER=
ALERTS_IMAP_PASSWORD=
# ALERTS_IMAP_HOST=imap.gmail.com
# ALERTS_IMAP_FOLDER=INBOX

# Optional: a Healthchecks.io ping URL; you get warned when the hunter stops (laptop asleep, crash)
HEALTHCHECK_URL=

# Optional: email delivery (Gmail needs an App Password, not the normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# EMAIL_TO_ALEX=

# Optional: official France Travail job API (free app at francetravail.io, API "Offres d'emploi v2")
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Optional: where application packs are saved (default: <HUNTER_HOME>/output)
HUNTER_OUTPUT=
# Optional: the folder holding candidates/, data/, output/ and this .env (default: the checkout itself).
# Set it in the environment, not here (this file is read from inside it).
# HUNTER_HOME=
# Optional: the person to use when --who is not given (default: your only person)
# HUNTER_CANDIDATE=alex
